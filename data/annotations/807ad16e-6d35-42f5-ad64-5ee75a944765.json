{"annotations":[{"start_time":0,"end_time":35,"annotation":[{"type":"paragraph","children":[{"text":"Introduction of topic from Carlos Sanchez - Stannford centre for health education"}]}],"tags":[{"tag":"Introduction","category":"Background"}],"uuid":"66243843-8057-4128-9a67-a5dc3408243d"},{"start_time":35,"end_time":45,"annotation":[{"type":"paragraph","children":[{"text":"Highlighting the juxtaposition between social media and real life"}]}],"tags":[{"tag":"Comparison","category":"Social Media Impact"}],"uuid":"9b101a9c-d869-4a0c-a987-a0ceeee6fdb2"},{"start_time":45,"end_time":79,"annotation":[{"type":"paragraph","children":[{"text":"Explaining who Dr  Nina Vasan is and the upcoming points"}]}],"tags":[{"tag":"Introduction","category":"Background"}],"uuid":"7063b56b-2090-4401-9f1f-5bb8a14b77c5"},{"start_time":96,"end_time":125,"annotation":[{"type":"paragraph","children":[{"text":"Social comparison is  demonstrated through likes/Engagment and can lead to anxiety "}]}],"tags":[{"tag":"Comparison","category":"Social Media Impact"}],"uuid":"f04bf1ab-4d85-4a88-9afe-38fe84d888a1"},{"start_time":126,"end_time":155,"annotation":[{"type":"paragraph","children":[{"text":"Content of social media triggers anxiety, promotes unrealistic beauty standards and convince you that your life is not good enough in comparison"}]}],"tags":[{"tag":"Anxiety trigger","category":"Social Media Impact"}],"uuid":"31904589-d8cd-45b0-8d48-989a3b591bf9"},{"start_time":155,"end_time":182,"annotation":[{"type":"paragraph","children":[{"text":"(Question and answer style filming) The benefits of social media, like social connection, can decrease anxiety"}]}],"tags":[{"tag":"Anxiety reduction","category":"Strategies"}],"uuid":"25b6750f-41ec-4302-a02d-e467d93eabff"},{"start_time":183,"end_time":221,"annotation":[{"type":"paragraph","children":[{"text":"Loneliness can be combatted with social media - however, those connections are not always authentic/meaningful"}]}],"tags":[{"tag":"Juxtaposition","category":"Social Media Impact"}],"uuid":"1d0495e6-09e3-4ed0-924a-53e92c726e5e"},{"start_time":226,"end_time":250,"annotation":[{"type":"paragraph","children":[{"text":"Social media can be addictive as it releases dopamine - comparison to effects of drugs and alcohol"}]}],"tags":[{"tag":"Addiction","category":"Social Media Impact"}],"uuid":"1169fd9c-ba25-4aea-a1af-a4f48243a903"},{"start_time":251,"end_time":260,"annotation":[{"type":"paragraph","children":[{"text":"Algorithim intentionally keeps you engaged by feeding you content based on your interactions"}]}],"tags":[{"tag":"Addiction","category":"Social Media Impact"}],"uuid":"b2106c8e-aac9-4365-8d9c-8939ee621775"},{"start_time":272,"end_time":281,"annotation":[{"type":"paragraph","children":[{"text":"Example of content being pushed by the algorithm that increases anxiety levels"}]}],"tags":[{"tag":"Anxiety trigger","category":"Social Media Impact"}],"uuid":"84a168f1-67fa-4902-a35b-bf6bf5cb604a"},{"start_time":282,"end_time":299,"annotation":[{"type":"paragraph","children":[{"text":"Harder to stop consumption due to instantanious nature of social media"}]}],"tags":[{"tag":"Addiction","category":"Social Media Impact"}],"uuid":"05471af2-b38d-4fc3-801f-36e19a9bd1f7"},{"start_time":300,"end_time":347,"annotation":[{"type":"paragraph","children":[{"text":"Algorithmic strategies to reduce your anxiety levels when consuming social media "}]}],"tags":[{"tag":"Strategies for anxiety reduction","category":"Strategies"}],"uuid":"23df0081-59e1-4054-a879-78cc489d0b32"},{"start_time":355,"end_time":405,"annotation":[{"type":"paragraph","children":[{"text":"External strategies one can adopt to reduce anxiety - healthy practices particularly around times of social media consumption"}]}],"tags":[{"tag":"Strategies for anxiety reduction","category":"Strategies"}],"uuid":"81ede464-f3bd-4e4e-bb0f-0698f923dc60"},{"start_time":410,"end_time":450,"annotation":[{"type":"paragraph","children":[{"text":"identifying signs that social media has become a problem in your life or a loved ones life "}]}],"tags":[{"tag":"Identifying signs","category":"Strategies"}],"uuid":"54edcaf4-6ad4-4507-a220-db091a2b7edd"},{"start_time":456,"end_time":485,"annotation":[{"type":"paragraph","children":[{"text":"Advice for problematic social media consumption"}]}],"tags":[{"tag":"Strategies for anxiety reduction","category":"Strategies"}],"uuid":"f7589b81-c81b-4e56-9884-901ebd86dab5"},{"start_time":486,"end_time":493,"annotation":[{"type":"paragraph","children":[{"text":"Credits to all involved in the  film and the University"}]}],"tags":[{"tag":"Credit","category":"Credits"}],"uuid":"039eaad2-15cf-4005-8984-81bac0838d6c"}],"set":"Default","event_id":"2ae946cc-213e-4288-a122-128df2a8e321","source_id":"f66f39b1-f95a-49ac-bedf-44d25ce3300c"}